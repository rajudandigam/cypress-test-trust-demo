{
  "name": "cypress-test-trust-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "db:up": "tsx scripts/db-up.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:api": "vitest run --config vitest.config.ts tests/api",
    "test:policy": "tsx scripts/test-policy.ts",
    "test:critical": "tsx scripts/test-critical.ts",
    "test:adaptive": "tsx scripts/test-adaptive.ts",
    "test:hybrid": "tsx scripts/test-hybrid.ts",
    "cy:open": "cypress open --e2e --config-file cypress.config.ts",
    "cy:open:adaptive": "cypress open --e2e --browser chrome --config-file cypress.adaptive.config.ts",
    "demo:up": "tsx scripts/demo-up.ts",
    "demo:capture": "tsx scripts/demo-capture.ts",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "cypress": "16.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
