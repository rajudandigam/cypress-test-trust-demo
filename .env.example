# Copy to .env for local development. Synthetic values only — never real credentials.

NODE_ENV=development
PORT=3000
API_PORT=3001

# Demo/test enablement required for scenario overrides and destructive reset
DEMO_MODE=true
DEMO_SCENARIO=healthy

# Controllable clock for demo (ISO). Empty = system clock.
DEMO_FIXED_NOW=2026-10-01T12:00:00.000Z

DATABASE_URL=postgresql://cypress_demo:cypress_demo@127.0.0.1:5432/cypress_test_trust_demo
TEST_DATABASE_URL=postgresql://cypress_demo:cypress_demo@127.0.0.1:5432/cypress_test_trust_demo_test

# Expected database name substrings for safety checks on reset/seed
ALLOWED_DB_NAME_PATTERN=cypress_test_trust_demo

SESSION_SECRET=dev-only-session-secret-change-me
COOKIE_NAME=cttd_session

# Seeded traveler password (hashed at seed time)
SEED_PASSWORD=Password123!

# Cypress public expose values (non-secret)
CYPRESS_baseUrl=http://localhost:3000
